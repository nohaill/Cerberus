# Copy to .env and adjust. All vars are prefixed CERBERUS_ per app/config.py

# true = deterministic heuristics, no model downloads, no network needed.
# false = real HF models via transformers (requires network + torch).
CERBERUS_MOCK_MODE=true

CERBERUS_PROMPT_INJECTION_MODEL=protectai/deberta-v3-base-prompt-injection-v2
CERBERUS_EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base
CERBERUS_AI_TEXT_DETECTOR_MODEL=openai-community/roberta-base-openai-detector
CERBERUS_PII_NER_MODEL=dslim/bert-base-NER

CERBERUS_BLOCK_THRESHOLD=0.85
CERBERUS_ALLOW_THRESHOLD=0.35

CERBERUS_MAX_CONCURRENT_CLASSIFIERS=8
CERBERUS_REQUEST_TIMEOUT_SECONDS=5.0
